# back-calc ACU from any OD using the pooled fit
acu_from_od <- function(od, blk, ox) {
  y  <- pmin(pmax((od - blk) / ox, 0.001), 0.999)
  cc <- coef(fit)
  out <- 10 ^ ((log(y / (1 - y)) - cc[1]) / cc[2])
  pmin(pmax(out, 0.5), 256)   # cap extrapolated values
}


# Pull every sample well into a flat frame. Skip col 1-2 (standards),
# col 3 (neg + QC), col 4 rows 1-4 (QC low + D blank), col 12 (blanks).
wlist <- list()
for (nm in names(plates)) {
  M  <- plates[[nm]]
  b  <- blanks[nm]
  ox <- odmaxes[nm]
  pid <- as.integer(nm)
  for (cn in 3:11) {
    if (cn == 3) next
    for (rn in 1:8) {
      if (cn == 4 && rn <= 4) next
      raw <- M[rn, cn]
      wlist[[length(wlist) + 1]] <- data.frame(
        plate = pid,
        row = LETTERS[rn],
        col = cn,
        well = paste0(LETTERS[rn], cn),
        id = paste0("P", pid, "_c", cn, "_", ceiling(rn / 2)),
        raw_od = raw,
        bs_od = raw - b,
        acu = acu_from_od(raw, b, ox))
    }
  }
}
wells <- do.call(rbind, wlist)
stopifnot(nrow(wells) == 240)


# QC wells -- 3 sample-type x 3 reps x 4 plates = 36
qc_positions <- list(
  QC_high = list(col = 3, rows = 3:5),
  QC_mid  = list(col = 3, rows = 6:8),
  QC_low  = list(col = 4, rows = 1:3)
)
qc <- bind_rows(lapply(names(plates), function(nm) {
  M  <- plates[[nm]]
  b  <- blanks[nm]
  ox <- odmaxes[nm]
  bind_rows(lapply(names(qc_positions), function(lbl) {
    p <- qc_positions[[lbl]]
    data.frame(
      plate  = as.integer(nm),
      well   = paste0(LETTERS[p$rows], p$col),
      qc     = lbl,
      raw_od = M[p$rows, p$col],
      bs_od  = M[p$rows, p$col] - b,
      acu    = acu_from_od(M[p$rows, p$col], b, ox))
  }))
}))


# intra-assay: within-plate triplicate CV averaged across plates
# inter-assay: CV of plate means
intra <- qc %>%
  group_by(qc, plate) %>% summarise(cv = 100 * sd(acu)/mean(acu), .groups = "drop") %>%
  group_by(qc) %>% summarise(intra_cv = mean(cv), .groups = "drop")

inter <- qc %>%
  group_by(qc, plate) %>% summarise(pm = mean(acu), .groups = "drop") %>%
  group_by(qc) %>% summarise(inter_cv = 100 * sd(pm)/mean(pm), .groups = "drop")

print(left_join(intra, inter, by = "qc"))
cat(sprintf("pooled intra (high+mid): %.1f%%\n",
            mean(intra$intra_cv[intra$qc != "QC_low"])))
cat(sprintf("pooled inter (high+mid): %.1f%%\n",
            mean(inter$inter_cv[inter$qc != "QC_low"])))
cat(sprintf("low QC inter: %.1f%%\n",
            inter$inter_cv[inter$qc == "QC_low"]))


# average duplicate wells, 240 -> 120 sample pairs
samples <- wells %>%
  group_by(plate, col, id) %>%
  summarise(
    pair = as.integer(sub(".*_", "", id[1])),
    n = n(),
    mean_acu = mean(acu),
    dup_cv = 100 * sd(acu)/mean(acu),
    mean_od = mean(raw_od),
    .groups = "drop") %>%
  select(plate, col, pair, id, n, mean_acu, dup_cv, mean_od) %>%
  arrange(plate, col, pair)

cat(sprintf("\nn = %d sample pairs, median dup CV = %.1f%%\n",
            nrow(samples), median(samples$dup_cv, na.rm = TRUE)))


# Grubbs one-sided on the max -- toss the obvious one
G <- (max(samples$mean_acu) - mean(samples$mean_acu)) / sd(samples$mean_acu)
cat(sprintf("Grubbs G = %.3f at ACU = %.1f -- excluded\n",
            G, max(samples$mean_acu)))
trimmed <- samples %>% filter(mean_acu < 200)

with(trimmed, {
  cat(sprintf("\nn = %d after exclusion\n", length(mean_acu)))
  cat(sprintf("mean %.2f, median %.2f, sd %.2f\n",
              mean(mean_acu), median(mean_acu), sd(mean_acu)))
  cat(sprintf("range %.2f - %.2f\n", min(mean_acu), max(mean_acu)))
  cat(sprintf("IQR %.1f - %.1f\n",
              quantile(mean_acu, .25), quantile(mean_acu, .75)))
})

sw <- shapiro.test(log(trimmed$mean_acu))
cat(sprintf("shapiro on log(ACU): p = %.3f\n", sw$p.value))


# Export. R drops trailing zeros on numeric columns when writing, so
# sprintf the columns where I want fixed precision and write as character.
write.csv(transform(sc,
    log10_acu   = sprintf("%.4f", log10_acu),
    raw_od      = sprintf("%.3f", raw_od),
    bs_od       = sprintf("%.4f", bs_od),
    rel_binding = sprintf("%.6f", rel_binding),
    logit_y     = sprintf("%.4f", logit_y)),
  "Standard Curve", row.names = FALSE, quote = FALSE)

write.csv(transform(wells,
    raw_od = sprintf("%.3f", raw_od),
    bs_od  = sprintf("%.4f", bs_od),
    acu    = sprintf("%.2f", acu)),
  "ACU Test Wells", row.names = FALSE, quote = FALSE)

write.csv(transform(qc,
    raw_od = sprintf("%.3f", raw_od),
    bs_od  = sprintf("%.4f", bs_od),
    acu    = sprintf("%.2f", acu)),
  "ACU QC Wells", row.names = FALSE, quote = FALSE)

write.csv(transform(samples,
    mean_acu = sprintf("%.2f", mean_acu),
    dup_cv   = sprintf("%.1f", dup_cv),
    mean_od  = sprintf("%.3f", mean_od)),
  "ACU Sample Values", row.names = FALSE, quote = FALSE)
