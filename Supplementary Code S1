# ---- back-calculate ACU ----
# this is the actual workhorse function

get_acu <- function(od, blank, odmax) {
  bs <- od - blank
  y <- pmin(pmax(bs / odmax, 0.001), 0.999)
  lg <- log(y / (1 - y))
  b <- coef(fit)
  out <- 10^((lg - b[1]) / b[2])
  pmin(pmax(out, 0.5), 256)  # cap extrapolated values
}


# ---- extract test samples ----

wells <- do.call(rbind, lapply(seq_along(plate_ids), function(i) {
  od <- od_plates[[i]]; pp <- params[[i]]
  out <- data.frame()
  for (col in 3:11) {
    for (row in 1:8) {
      if (!is_test(row, col)) next
      raw <- od[row, col]
      if (is.na(raw)) next
      out <- rbind(out, data.frame(
        plate = plate_ids[i], row = LETTERS[row], col = col,
        well = paste0(LETTERS[row], col),
        pair_id = paste0("P", plate_ids[i], "_c", col, "_", ceiling(row/2)),
        raw_od = raw, bs = raw - pp$blank,
        acu = get_acu(raw, pp$blank, pp$odmax),
        stringsAsFactors = FALSE))
    }
  }
  out
}))

cat(sprintf("\ntest wells: %d\n", nrow(wells)))  # should be 240


# ---- QC ----

qc <- do.call(rbind, lapply(seq_along(plate_ids), function(i) {
  od <- od_plates[[i]]; pp <- params[[i]]
  out <- data.frame()
  for (col in 3:4) {
    for (row in 1:8) {
      lab <- get_qc(row, col)
      if (is.na(lab)) next
      out <- rbind(out, data.frame(
        plate = plate_ids[i], well = paste0(LETTERS[row], col),
        qc = lab, raw_od = od[row, col],
        acu = get_acu(od[row, col], pp$blank, pp$odmax),
        stringsAsFactors = FALSE))
    }
  }
  out
}))

# intra-assay: triplicate CV within each plate
intra <- qc %>% group_by(qc, plate) %>%
  summarise(cv = 100 * sd(acu)/mean(acu), .groups = "drop") %>%
  group_by(qc) %>% summarise(mean_cv = mean(cv), .groups = "drop")
print(intra)
# pooled from high + mid only (low is reported separately)
cat(sprintf("pooled intra (high+mid): %.1f%%\n",
            mean(intra$mean_cv[intra$qc != "QC_low"])))

# inter-assay: CV of plate means
inter <- qc %>% group_by(qc, plate) %>%
  summarise(pm = mean(acu), .groups = "drop") %>%
  group_by(qc) %>%
  summarise(inter_cv = 100 * sd(pm)/mean(pm), .groups = "drop")
print(inter)
cat(sprintf("pooled inter (high+mid): %.1f%%\n",
            mean(inter$inter_cv[inter$qc != "QC_low"])))
cat(sprintf("low QC inter: %.1f%%\n", inter$inter_cv[inter$qc == "QC_low"]))


# ---- average duplicates ----

samples <- wells %>%
  group_by(plate, col, pair_id) %>%
  summarise(mean_acu = mean(acu),
            dup_cv = 100 * sd(acu)/mean(acu),
            n = n(), .groups = "drop") %>%
  arrange(plate, col)

cat(sprintf("\nn=%d samples, median dup CV=%.1f%%\n",
            nrow(samples), median(samples$dup_cv, na.rm = TRUE)))


# ---- outlier + population summary ----

G <- (max(samples$mean_acu) - mean(samples$mean_acu)) / sd(samples$mean_acu)
cat(sprintf("grubbs G=%.3f (ACU=%.1f) — obvious outlier\n", G, max(samples$mean_acu)))

trimmed <- samples %>% filter(mean_acu < 200)

cat(sprintf("\n--- n=%d after outlier exclusion ---\n", nrow(trimmed)))
cat(sprintf("mean=%.2f  median=%.2f  sd=%.2f\n",
            mean(trimmed$mean_acu), median(trimmed$mean_acu), sd(trimmed$mean_acu)))
cat(sprintf("range: %.2f - %.2f\n", min(trimmed$mean_acu), max(trimmed$mean_acu)))
cat(sprintf("IQR: %.1f - %.1f\n",
            quantile(trimmed$mean_acu, .25), quantile(trimmed$mean_acu, .75)))

sw <- shapiro.test(log(trimmed$mean_acu))
cat(sprintf("shapiro on log(ACU): p=%.3f %s\n", sw$p.value,
            ifelse(sw$p.value > 0.05, "— log-normal not rejected", "")))


