# ---- plate map ----
# col 1-2: dup standard curve (128 -> 1 ACU, rows A-H)
# col 3 A-B: neg controls
# col 3 C-E: QC high (FSJ-490), triplicate
# col 3 F-H: QC mid (FSJ-475), triplicate
# col 4 A-C: QC low (FSJ-491), triplicate
# col 4 D: blank
# col 4 E-H, col 5-11: test samples, dup pairs A+B C+D E+F G+H
# col 12: blanks

odmax_scale <- 1.10  # headroom so logit doesn't blow up at the top

is_test <- function(r, c) {
  if (c <= 2 || c == 12) return(FALSE)
  if (c == 3) return(FALSE)  # whole column is neg or QC
  if (c == 4 && r <= 4) return(FALSE)  # QC low + blank
  TRUE
}

get_qc <- function(r, c) {
  if (c == 3 && r %in% 3:5) return("QC_high")
  if (c == 3 && r %in% 6:8) return("QC_mid")
  if (c == 4 && r %in% 1:3) return("QC_low")
  NA_character_
}


# ---- blanks and OD_max ----
# 9 blank wells per plate: col 12 (8) + D4 (1)

get_params <- function(od) {
  blk <- mean(c(od[, 12], od["D", 4]))
  bs128 <- mean(c(od["A", 1], od["A", 2])) - blk
  list(blank = blk, odmax = bs128 * odmax_scale,
       sc1 = od[, 1], sc2 = od[, 2])
}

params <- lapply(od_plates, get_params)
for (i in seq_along(plate_ids))
  cat(sprintf("  P%d blank=%.4f odmax=%.4f\n",
              plate_ids[i], params[[i]]$blank, params[[i]]$odmax))


# ---- standard curve ----
# normalize each plate to relative binding, logit transform, pool everything

sc <- do.call(rbind, lapply(seq_along(plate_ids), function(i) {
  pp <- params[[i]]
  bs1 <- pp$sc1 - pp$blank; bs2 <- pp$sc2 - pp$blank
  y1 <- pmin(pmax(bs1 / pp$odmax, 0.001), 0.999)
  y2 <- pmin(pmax(bs2 / pp$odmax, 0.001), 0.999)
  data.frame(plate = factor(plate_ids[i]),
             acu = rep(acu_conc, 2),
             log_acu = rep(log10(acu_conc), 2),
             bs = c(bs1, bs2),
             logit_y = c(log(y1/(1-y1)), log(y2/(1-y2))),
             rep = rep(c("c1","c2"), each = 8))
}))

fit <- lm(logit_y ~ log_acu, data = sc)
summary(fit)

cat(sprintf("\npooled: logit(y) = %.4f + %.4f * log10(ACU), R2=%.4f\n",
            coef(fit)[1], coef(fit)[2], summary(fit)$r.squared))

# per-plate slopes
for (pid in plate_ids) {
  s <- coef(lm(logit_y ~ log_acu, data = sc[sc$plate == pid, ]))[2]
  cat(sprintf("  P%d slope=%.3f\n", pid, s))
}
pslopes <- sapply(plate_ids, function(pid)
  coef(lm(logit_y ~ log_acu, data = sc[sc$plate == pid, ]))[2])
cat(sprintf("  slope range: %.2f-%.2f, CV=%.1f%%\n",
            min(pslopes), max(pslopes), 100*sd(pslopes)/mean(pslopes)))


# ---- mixed effects ----
# do plate random effects matter after normalization?
# spoiler: no

me <- lmer(logit_y ~ log_acu + (1 + log_acu | plate), data = sc,
           REML = TRUE, control = lmerControl(optimizer = "bobyqa"))
# boundary singular fit warning is expected — means random effects are ~0
summary(me)
VarCorr(me)
ranef(me)

me0 <- lmer(logit_y ~ log_acu + (1 | plate), data = sc,
            REML = TRUE, control = lmerControl(optimizer = "bobyqa"))
anova(me0, me, refit = FALSE)  # p=1, random slope adds nothing

