plates <- list(`26` = p26, `27` = p27, `28` = p28, `29` = p29)
std_concs <- c(128, 64, 32, 16, 8, 4, 2, 1)


# blank = mean of col 12 (8 wells) + D4, so 9 wells/plate
# OD_max = blank-subtracted (A1+A2)/2 * 1.10
# 1.10 leaves headroom so y stays away from 1 and the logit doesn't blow up
blanks  <- sapply(plates, function(M) mean(c(M[, 12], M["D", 4])))
odmaxes <- mapply(function(M, b) mean(M["A", 1:2] - b) * 1.10, plates, blanks)

print(data.frame(plate = names(plates),
                 blank = round(blanks, 4),
                 odmax = round(odmaxes, 4),
                 row.names = NULL))


# Standard curve: 8 dilutions x 2 reps x 4 plates = 64 rows
sc <- bind_rows(lapply(names(plates), function(nm) {
  M  <- plates[[nm]]
  b  <- blanks[nm]
  ox <- odmaxes[nm]
  bs <- c(M[, 1], M[, 2]) - b
  y  <- pmin(pmax(bs / ox, 0.001), 0.999)
  data.frame(
    plate = as.integer(nm),
    acu = rep(std_concs, 2),
    log10_acu = rep(log10(std_concs), 2),
    replicate = rep(c("col1", "col2"), each = 8),
    raw_od = c(M[, 1], M[, 2]),
    bs_od = bs,
    rel_binding = y,
    logit_y = log(y / (1 - y))
  )
}))

fit <- lm(logit_y ~ log10_acu, data = sc)
cat(sprintf("\npooled: logit(y) = %.4f + %.4f * log10(ACU), R2 = %.4f\n",
            coef(fit)[1], coef(fit)[2], summary(fit)$r.squared))

# parallelism sanity check: per-plate slopes should be tight
pslopes <- sapply(unique(sc$plate), function(p)
  coef(lm(logit_y ~ log10_acu, data = sc, subset = plate == p))[2])
names(pslopes) <- paste0("P", unique(sc$plate))
print(round(pslopes, 3))
cat(sprintf("slope CV = %.1f%%\n\n", 100 * sd(pslopes) / mean(pslopes)))


# Mixed model just to confirm the random plate effects are negligible
# after normalization. The boundary singular fit warning is the answer,
# not a problem.
sc$plate_f <- factor(sc$plate)
me  <- lmer(logit_y ~ log10_acu + (1 + log10_acu | plate_f), data = sc,
            REML = TRUE, control = lmerControl(optimizer = "bobyqa"))
me0 <- lmer(logit_y ~ log10_acu + (1 | plate_f), data = sc,
            REML = TRUE, control = lmerControl(optimizer = "bobyqa"))
print(VarCorr(me))
anova(me0, me, refit = FALSE)
sc$plate_f <- NULL

# tried nlme too, same result -- random effect CIs include 0
